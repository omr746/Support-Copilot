# Copy to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real keys. This file lists NAMES only.

# --- LLM and speech (Groq) ---
GROQ_API_KEY=

# --- LLM fallback (Google Gemini, from Google AI Studio) ---
GEMINI_API_KEY=

# --- Tracing and experiments (Langfuse Cloud & Jaeger) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=support-copilot

# --- Web Crawler (Contact address sent in User-Agent header, never committed to git) ---
# Required for `make crawl` or `python -m copilot.rag.crawler.cli`
CRAWL_CONTACT=
APP_JWT_SECRET=

# --- Database (Postgres with pgvector) ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=
POSTGRES_DB=copilot

# --- Docker Compose ---
COMPOSE_PROFILES=core
